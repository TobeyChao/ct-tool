enum LayerEnum : byte { Page = 0, Modal = 1, Panel = 2, Overlay = 3 }

table UIConfig {
  Id: int32;
  Layer: LayerEnum;
  ResourceKey: string;
  BlocksRaycast: bool;
  Stack: bool;
}

struct IndexEntry {
  id: int32;
  row: int32;
}

table UIConfigTable {
  items: [UIConfig];
  index: [IndexEntry];
}

root_type UIConfigTable;
