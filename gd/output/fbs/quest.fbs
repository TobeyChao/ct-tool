table Quest {
  id: int32;
  title: string;
  description: string;
  reward_item_id: int32;
  required_level: int32;
}

table QuestTable {
  items: [Quest];
}

table QuestI18nEntry {
  id: int32;
  title: string;
  description: string;
}

table QuestI18nTable {
  entries: [QuestI18nEntry];
}

root_type QuestTable;
