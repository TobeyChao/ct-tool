<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- 枚举声明现在由导出器产出（generated/Enums.cs），不再需要手写那份 -->

    <!-- _ws 是导出用的临时工作区，不参与编译 -->
    <Compile Remove="_ws\**\*.cs" />
    <None Remove="_ws\**" />
    <Compile Include="..\ConfigAccessorBench\WireReader.cs" />
    <Compile Include="..\ConfigAccessorBench\Runtime.cs" />
    <Compile Include="..\ConfigAccessorBench\ConfigReader.cs" />
    <None Include="fixtures\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
