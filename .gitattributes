# 默认：自动检测文本/二进制（仓库统一存 LF，工作区随平台）
* text=auto

# 源码文件
*.py      text diff=python
*.yaml    text
*.yml     text
*.json    text
*.lua     text
*.cs      text
*.cpp     text
*.h       text
*.md      text
*.txt     text
*.cfg     text
*.toml    text
*.ini     text
# 平台关键文件：shell 脚本必须 LF，Windows 批处理/脚本必须 CRLF
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 生成的代码 / 文档（视为源码一样的文本处理）
*.fbs        text
*.accessor   text

# Excel / Office（二进制）
*.xlsx    binary
*.xlsm    binary
*.xls     binary
*.xlsb    binary

# FlatBuffers 产物
*.bin     binary

# 字体 / 图片 / 音频 / 模型（二进制）
*.ttf     binary
*.otf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.svg     text
*.ico     binary
*.wav     binary
*.mp3     binary
*.ogg     binary
*.fbx     binary
*.obj     binary
*.blend   binary

# 压缩 / 包文件
*.zip     binary
*.tar     binary
*.gz      binary
*.7z      binary
*.rar     binary

# 可执行文件 / DLL
*.exe     binary
*.dll     binary
*.so      binary
*.dylib   binary
*.pdb     binary

# 数据库 / 缓存
*.db      binary
*.sqlite  binary

# 忽略的路径无条件不导出 (export-ignore 在 git archive 时排除)
.gitattributes  export-ignore
.gitignore       export-ignore
.claude/         export-ignore
